{
  "expo": {
    "name": "Yelen Service",
    "slug": "yelen-service",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yelen",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ml.yelen.boutique"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ml.yelen.boutique",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ff5000",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "primaryColor": "#ff5000",
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#ff5000"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34eec3a9-732b-454a-8632-82eb873e1fe0"
      }
    },
    "owner": "mohpython"
  }
}
